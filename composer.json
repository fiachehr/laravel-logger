{
    "name": "fiachehr/laravel-logger",
    "description": "Privacy-first structured JSON logging and an authorized, bounded log explorer for Laravel.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "logging",
        "observability",
        "jsonl",
        "log-explorer"
    ],
    "homepage": "https://github.com/fiachehr/laravel-logger",
    "support": {
        "issues": "https://github.com/fiachehr/laravel-logger/issues",
        "source": "https://github.com/fiachehr/laravel-logger"
    },
    "require": {
        "ext-json": "*",
        "ext-mbstring": "*",
        "illuminate/auth": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/encryption": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/log": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/session": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/validation": "^12.0 || ^13.0",
        "illuminate/view": "^12.0 || ^13.0",
        "monolog/monolog": "^3.0",
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Fiachehr\\LaravelLogger\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Fiachehr\\LaravelLogger\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fiachehr\\LaravelLogger\\LoggerServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
